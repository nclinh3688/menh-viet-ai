# PostgreSQL is required for Public Beta production and recommended for local beta testing.
# Use a local PostgreSQL database or a Neon/Supabase/Vercel Postgres development branch.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Auth.js / NextAuth Google login
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# NextAuth v4 vẫn đọc NEXTAUTH_*; giữ đồng bộ với AUTH_* khi chạy local.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# OAuth providers - configure later, never commit real secrets
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Public app metadata
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Mệnh Việt AI"
# Backward-compatible alias used by older metadata helpers. Keep equal to NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
