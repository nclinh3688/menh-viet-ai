generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  profiles      Profile[]
  subscriptions Subscription[]
  aiReports     AiReport[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id                 String                @id @default(cuid())
  userId             String?
  user               User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName           String
  birthDate          DateTime
  birthTime          String?
  gender             Gender
  birthPlace         String?
  calendarType       CalendarType          @default(SOLAR)
  relationshipStatus String?
  mainInterest       String?
  birthChart         BirthChart?
  dailyFortunes      DailyFortune[]
  aiReports          AiReport[]
  maleReports        CompatibilityReport[] @relation("MaleCompatibilityProfile")
  femaleReports      CompatibilityReport[] @relation("FemaleCompatibilityProfile")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([userId])
  @@index([birthDate])
}

model BirthChart {
  id             String   @id @default(cuid())
  profileId      String   @unique
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  heavenlyStem   String
  earthlyBranch  String
  zodiacAnimal   String
  element        String
  napAm          String
  cungPhi        String
  lifePalace     String?
  luckyColors    String   @default("[]")
  unluckyColors  String   @default("[]")
  luckyNumbers   String   @default("[]")
  goodDirections String   @default("[]")
  badDirections  String   @default("[]")
  summary        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CompatibilityReport {
  id              String   @id @default(cuid())
  maleProfileId   String?
  femaleProfileId String?
  maleProfile     Profile? @relation("MaleCompatibilityProfile", fields: [maleProfileId], references: [id], onDelete: SetNull)
  femaleProfile   Profile? @relation("FemaleCompatibilityProfile", fields: [femaleProfileId], references: [id], onDelete: SetNull)
  maleInfo        String?
  femaleInfo      String?
  totalScore      Int
  cungPhiScore    Int
  diaChiScore     Int
  nguHanhScore    Int
  thienCanScore   Int
  otherScore      Int
  summary         String
  details         String   @default("{}")
  createdAt       DateTime @default(now())

  @@index([maleProfileId])
  @@index([femaleProfileId])
}

model DailyFortune {
  id            String   @id @default(cuid())
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date          DateTime
  totalScore    Int
  loveScore     Int
  workScore     Int
  financeScore  Int
  mentalScore   Int
  luckyColor    String
  luckyNumber   String
  goodDirection String
  advice        String
  createdAt     DateTime @default(now())

  @@unique([profileId, date])
  @@index([date])
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan   @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  expiresAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}

model AiReport {
  id        String   @id @default(cuid())
  userId    String?
  profileId String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  type      String
  title     String
  content   String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([profileId])
  @@index([type])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CalendarType {
  SOLAR
  LUNAR
}

enum SubscriptionPlan {
  FREE
  PREMIUM
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELED
}
